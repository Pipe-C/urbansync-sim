# UrbanSync Sim — backend environment
#
# Copy to `.env` and fill in. `.env` is git-ignored; this file is the contract.
# See AGENTS.md § Environment variables.

ENVIRONMENT=development

# Async driver is required — the app is async end to end.
# Local development without Docker: SQLite needs no server. Uncomment this
# line instead of the PostgreSQL one below.
# DATABASE_URL=sqlite+aiosqlite:///./urbansync.db
#
# PostgreSQL is the deployed target; both backends run the same migration.
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/urbansync

# Generate a real 256-bit value for anything that is not local development:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-insecure-generate-a-real-256-bit-value

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# JSON array. Local Vite dev server; Vercel preview URLs are matched by a regex
# in `app/core/config.py` rather than enumerated here.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
